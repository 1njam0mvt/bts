# Copy to .env and edit. Never commit .env.

NODE_ENV=production
PORT=3000

# Your public address, no trailing slash. Used for canonical links, sitemap and social cards.
SITE_URL=https://www.example.com

# Admin panel at /admin  (REQUIRED in production, 8+ characters)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-long-password

# Set to true when running behind Nginx, Cloudflare, Render, Railway, etc.
# so rate limiting sees the visitor's real IP.
TRUST_PROXY=true

# Optional: where data and uploaded images are stored (use a persistent disk in production)
# DATA_DIR=/var/data/armyhub
# UPLOAD_DIR=/var/data/armyhub/uploads

# Optional: email yourself each contact message (leave blank to read them in /admin only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="ARMY Hub <you@gmail.com>"
# CONTACT_TO=you@gmail.com
